---
import '../styles/fonts.css';
import '../styles/site.css';
import latinFont from '../assets/fonts/libre-franklin-latin.woff2?url';
import '../styles/details.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  /* pages that should not be listed by search engines (the resume redirect) */
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
/* the social preview: the page's own image, or the home screen (og.jpg) */
const ogImage = new URL(image ?? '/og.jpg', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    <!-- the cabinet's colour, so the browser's own bars meet the set's edge -->
    <meta name="theme-color" content="#cfd5de" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050608" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- the type is served from here (styles/fonts.css); the latin file covers every page's text -->
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- screenshots come on when they have loaded instead of popping in (details.css) -->
    <script is:inline>['load', 'error'].forEach(function (t) { document.addEventListener(t, function (e) { if (e.target.tagName === 'IMG') e.target.setAttribute('data-loaded', ''); }, true); });</script>
    <!-- first party visitors, collected by the daviddn.cloud server through this host's /a/ route -->
    <script is:inline defer src="/a/t.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
